{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flujo.gota/review-result/v1",
  "title": "Flujo Gota Review Result v1",
  "$comment": "This Draft 2020-12 schema covers JSON-local structure, required fields, enums, and SHA formats. Its integer type accepts mathematically integral numbers such as 1.0. Python validation additionally normalizes attempt to int and enforces request_id == run_id + ':' + attempt + ':review'; no non-standard JSON Schema extension is used.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "message",
    "request_id",
    "task_id",
    "run_id",
    "attempt",
    "reviewed_commit_sha",
    "decision",
    "findings",
    "evidence"
  ],
  "properties": {
    "protocol": {"const": "flujo.gota/v1"},
    "message": {"const": "review.result"},
    "request_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "attempt": {"type": "integer", "minimum": 1},
    "reviewed_commit_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "decision": {
      "enum": [
        "PASSED",
        "CORRECTION_REQUIRED",
        "HUMAN_REVIEW_REQUIRED",
        "BLOCKED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "evidence": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "severity": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "path": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "required_change": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    }
  }
}
