{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flujo.gota/request/v1",
  "title": "Flujo Gota Request v1",
  "$comment": "This Draft 2020-12 schema covers JSON-local structure, required fields, enums, and SHA formats. Its integer type accepts mathematically integral numbers such as 1.0. Python validation additionally normalizes attempt to int and enforces request_id == run_id + ':' + attempt + ':' + phase; no non-standard JSON Schema extension is used.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "task_id",
    "run_id",
    "attempt",
    "phase",
    "objective",
    "acceptance_criteria",
    "workspace",
    "branch",
    "base_sha",
    "allowed_paths",
    "protected_paths"
  ],
  "properties": {
    "protocol": {"const": "flujo.gota/v1"},
    "request_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "attempt": {"type": "integer", "minimum": 1},
    "phase": {"enum": ["worker", "review"]},
    "objective": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "acceptance_criteria": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "workspace": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "branch": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "base_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "allowed_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "protected_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "previous_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "severity": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "path": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "required_change": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    }
  }
}
